OPENTOPOGRAPHY_API_KEY=YOUR_ROTATED_OPENTOPOGRAPHY_KEY
# Required on public backend: choose a separate strong access code, not the provider API key
GEODEM_ACCESS_TOKEN=CHOOSE_A_LONG_RANDOM_ACCESS_TOKEN
# HTTPS origin(s) allowed to request jobs
GEODEM_CORS_ORIGINS=https://geodem-explorer.vercel.app,http://127.0.0.1:8000,http://localhost:8000
DATA_DIR=./data
MAX_UPLOAD_MB=25
MAX_TILES_PER_DATASET=64
MAX_AREA_KM2=300000
JOB_WORKERS=2
REQUEST_TIMEOUT_SECONDS=240
